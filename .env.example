# 环境变量样例 —— 复制为 .env 后填入真实值
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# 注意：.env 已被 .gitignore 忽略，不要把它提交到仓库。

# ---------------------------------------------------------------------------
# 必填：视觉层供应商与 API 密钥
# ---------------------------------------------------------------------------
# 视觉层供应商：deepseek（默认）/ zhipu（回退到 GLM-4.6V 系列）。
# 这里显式写 deepseek 就是**启用新 provider**；把它改成 zhipu（或整行删掉）即回退，
# 代码默认值（`DEFAULT_VISION_PROVIDER`）本身已是 deepseek —— 2026-09-21 双 provider 的
# A/B 闸门（S1 要素不倒退 / S2 分类一致率 97.2%）判定通过后才切换的。
# 取值写错时不会报错，而是静默回落成默认值 —— 用 `py -3.10 -m tools.diag` 确认实际生效值。
VISION_PROVIDER=deepseek

# DeepSeek 密钥：视觉（分类 / OCR / 视觉推理 / 核对）+ 求解共用。
# VISION_PROVIDER=deepseek 时**必填**。
DEEPSEEK_API_KEY=

# 智谱密钥：**仅在 VISION_PROVIDER=zhipu 时需要**（回退方案）。
# 其余情况留空即可，不影响启动。
# ZHIPU_API_KEY=

# 如果新增 provider（见 problem_solver_agent/config.py 的 VISION_PROVIDER_CONFIG），
# 密钥命名规则为 {PROVIDER_NAME}_API_KEY，全部大写。

# ---------------------------------------------------------------------------
# 可选：路径（默认写在项目父目录，建议显式指定以免产物跑到别处）
# ---------------------------------------------------------------------------
# 工作根目录。其下会创建 Screenshots/、processed/、solutions/ 三个目录。
# 不设置时默认取项目目录的父目录（历史行为）。例如：
# SOLVER_ROOT_DIR=D:\Users\wzw\Pictures

# ---------------------------------------------------------------------------
# 可选：Agent 行为
# ---------------------------------------------------------------------------
# 关闭自动截图导入（默认 true）
# AUTO_IMPORT_ENABLED=true

# 连续截图的分组超时（秒），超过该时间没有新截图就视为一组完成
# GROUP_TIMEOUT=8

# 补偿扫描：兜住丢失的文件系统事件（同步工具"改名就位"、watchdog 缓冲区溢出、
# 进程停机期间到达的文件）。默认每 15 秒扫一遍监控目录，0 = 关闭周期扫描。
# MONITOR_RESCAN_INTERVAL=15
# 只补投 mtime 在这个分钟数以内的文件（0 = 不限年龄）
# MONITOR_CATCHUP_MAX_AGE_MINUTES=120
# 启动时是否先扫一遍目录（补上上次运行期间到达的照片）
# MONITOR_STARTUP_SCAN=true
# 手机遥控截图服务（tools/remote_trigger.py）的端口：手机扫码后点按钮触发电脑截图
# REMOTE_TRIGGER_PORT=5555

# 每个任务最多同时处理几个（自动导入与手动上传共享）
# MAX_CONCURRENT_TASKS=2

# 编程题求解风格：OPTIMAL（最优解）或 EXPLORATORY（讲解式）
# SOLVER_STYLE=OPTIMAL

# 求解调用的输出上限（token），首选档（不开思考时全部留给正文）。默认 16000。
# SOLVER_MAX_TOKENS=16000

# 是否首选"思考模式"。默认 false：先不开思考快跑一次（简单题十几秒出答案），
# 只有答案不合格（空 / 被截断 / 编程题答案过短）时才自动升级到思考档重跑。
# 网页上手动"开启思考模式重解"不受此默认值影响。
# SOLVER_THINKING_DEFAULT=false
# SOLVER_ESCALATE_TO_THINKING=true
# 升级档的输出上限（实测该 API 接受 32768 / 65536）。默认 32000。
# SOLVER_ESCALATE_MAX_TOKENS=32000
# 编程题答案短于该字符数视为不合格，触发升级。默认 500。
# SOLVER_ESCALATE_MIN_CHARS=500
# 思考深度 low / medium / high，默认 medium
# SOLVER_REASONING_EFFORT=medium
# 思考过程字符上限：超过它且还没有正文就提前放弃思考（0 = 关闭该保护，默认关闭）
# SOLVER_REASONING_CHAR_LIMIT=0

# ---------------------------------------------------------------------------
# 可选：图片预处理（决定发给视觉模型的请求体积，直接影响出答案速度）
# ---------------------------------------------------------------------------
# 发送前把图片最长边缩放到该值。调大更清晰但更慢，调小更快但小字可能糊。
# IMAGE_MAX_EDGE=1600
# JPEG 质量
# IMAGE_JPEG_QUALITY=80
# 是否启用图片磁盘缓存
# IMAGE_CACHE_ENABLED=true
# 图片缓存总上限（MB）
# IMAGE_CACHE_MAX_MB=512

# ---------------------------------------------------------------------------
# 可选：视觉层（OCR / 分类）调用行为
# ---------------------------------------------------------------------------
# 是否关闭视觉调用的"思考模式"。默认 true。
# 为什么默认关：DeepSeek 的思考模式**默认开启且 effort=high**，而 OpenAI 兼容 SDK
# 不显式下发 `thinking.type=disabled` 就关不掉；分类/OCR 这类短任务的思考过程会把
# max_tokens 吃光，导致正文为空（与求解器踩过的是同一个坑）。
# 智谱不支持该开关，设了也不生效（回退路径与迁移前一致）。
# VISION_DISABLE_THINKING=true

# 视觉调用的输出上限（token）。默认 32768（旧实现写死 8192，会把多图合并转录截断）。
# 8 页转录约 6–16K token；成本按**实际生成量**计费，配额调大不会额外收费。
# VISION_MAX_TOKENS=32768

# 合并调用（一次带 N 张图）的单请求超时，默认 300 秒。
# 它与逐页 OCR 的输出量差一个数量级，共用 VISION_TIMEOUT=120 几乎必然超时。
# VISION_COMBINED_TIMEOUT=300

# 合并调用成功后是否**内联**拼接逐页文本（跳过"润色"调用），默认 true。
# CONT 页的接缝判断来自模型本身，本地 join 即可；若发现模型在 CONT 页多删了内容，
# 置 false 即回到「合并调用 + 独立润色」的老路径。
# VISION_INLINE_MERGE=true

# 题目文本的排版与公式规范化（两件事，互不影响）：
#   排版（始终生效、零 token）：剥离考试 App 的页眉/页脚/导航噪音（**保留题号与题型**，
#     `单选题 第18/60题 自动跳下一题` → `单选题 第18题`）、合并被翻页切开的代码围栏、
#     规整空行。它是"内联拼接跳过润色"当初欠下的一环。
#   公式（下面这个开关）：只把**公式片段**抽出来送一次模型规范化（输出几十 token，
#     而润色要重写整篇约 10K），再填回原位 —— 正文一个字符都不经过模型。
# 关掉公式规范化不影响排版。
# FORMULA_NORMALIZE=true
# 抽出的公式总字符数低于该值就跳过（收益小于一次网络往返）。
# FORMULA_MIN_CHARS=40

# 辅助调用（润色 / 文件名生成）的超时，默认 300 秒。
# 润色要重写整篇合并文本（输出 6–10K token），旧的硬编码 120 秒会超时并指数退避重试。
# AUX_TIMEOUT=300

# OCR 并行转录的线程数（**只影响合并调用失败后的回退路径**），默认 4。
# 约束不是 API 并发，而是本机 JPEG 解码/缩放的 CPU 占用。1 = 串行，4 = 四张并行。
# OCR_PARALLEL_WORKERS=4

# 生成解答文件名的模式：
#   auto（默认）= 优先用求解正文首行的 FILE: 建议，其次本地按题号生成，都没有才调模型
#   local       = 完全本地生成，从不调模型（最省一次隐形调用）
#   model       = 每次都调模型（旧行为）
# FILENAME_MODE=auto

# 合并调用（一次拿到"题型 + 全部逐页转录"）的开关模式：
#   auto（默认）= 只有图片数 <= COMBINED_VISION_MAX_IMAGES 时才尝试
#   true        = 总是尝试
#   false       = 从不尝试，直接走"分类 + 逐页转录"两步
# 协议已从 JSON 换成 `<<<PAGE n|NEW/CONT>>>` 分隔符（正文逐字直出、不经转义层），
# 输出上限也从 8192 提到 VISION_MAX_TOKENS，因此多图合并不再必然被截断 ——
# 历史上的"JSON 被截断导致解析失败"不再是限制，图片数上限恢复到 8。
# USE_COMBINED_VISION_CALL=auto
# COMBINED_VISION_MAX_IMAGES=8

# 分批合并：单次请求最多带几张图，以及批间并行度（默认 8 / 4）。
#
# **这不是 token 参数**：每张图独立计费、上限 1024 token/图，分批不重传图片，
# 所以 token 成本与它无关。它只影响请求数 / 单请求输出长度（越短越不易漏页）/ 延迟。
# 2026-09-23 实测（8 张真实题图 ×3 轮交替）：批量 4 → 8.7s / 3 请求 / 每轮补页；
# 批量 8 → 7.7s / 1 请求 / 0 补页 ⇒ 默认取 8。
#
# 它只对**超过 8 张的组**与默认的 `COMBINED_VISION_MAX_IMAGES=8` 有区别：
#   · 总图数 ≤ 8 → 1 批（=1 次请求，与 8 张一批的旧行为一致）
#   · 总图数 > 8 → 按本参数切批并发（如 16 张 → 2 批），图片仍只上传一次
# 旧默认值 4 会让 16 张的组变成 4 批 4 次请求，纯属多付固定开销。
#
# ⚠️ **别单独把它设成 16**：`COMBINED_VISION_MAX_IMAGES`（默认 8）是"允不允许走合并
# 路径"的闸门，卡的是**总图片数**且在分批之前 —— 总图数 >8 的组若不放宽闸门，
# **一次合并请求都不发**，整组回退「1 次分类 + N 次逐页 OCR」（图片被上传两次）。
# 实测（16 张图，`_probe/probe_batch_sizes.py`）：闸门=8 时批量 4/8/16 全部 0 请求；
# 闸门抬到 16 + 批量 16 才发出请求，但 16 页里有 9 页要补做（响应太长，模型漏抄）。
# VISION_BATCH_SIZE=8
# VISION_BATCH_WORKERS=4

# 多图合并文本短于该长度时跳过"润色"调用
# MERGE_SKIP_THRESHOLD=1200

# ---------------------------------------------------------------------------
# 可选：清理与保留
# ---------------------------------------------------------------------------
# 最多保留多少个任务（超出后连同上传原图一起清理）
# TASK_RETENTION_COUNT=100
# 任务最长保留天数，0 表示不按时间清理
# TASK_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# 可选：网络与超时
# ---------------------------------------------------------------------------
# 单次 API 调用超时（秒），在 config.py 中也可调整
# VISION_TIMEOUT=120

# 服务端口（容器部署时由 compose 固定为 8000）
# PORT=8000

# ---------------------------------------------------------------------------
# 访问控制与计费（多人使用时才需要）
# ---------------------------------------------------------------------------
# 默认 false = 单用户本地模式：不需要登录，任何能访问该端口的人都能提交任务
# 并消耗你的 API 额度。多人共用或对外暴露时请设为 true。
# AUTH_ENABLED=false

# JWT 签名密钥。AUTH_ENABLED=true 时**必须**显式设置，否则每次重启都会
# 生成临时密钥，导致已登录用户全部掉线。生成方法（任选）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=

# 登录令牌有效期（分钟），默认 24 小时
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 新用户注册赠送额度（元）。这是**估算**额度，用于限制滥用而非精确账单。
# DEFAULT_USER_BUDGET=10.0

# 提交一次任务所需的最低剩余额度（元）。低于该值直接拒绝，
# 避免"余额不足却已经跑完一次付费调用"。
# MIN_TASK_BUDGET=0.05

# 短信验证码：console 表示不真正发短信，而是把验证码回显在 /api/v1/auth/send-code
# 的响应里（仅用于本地开发与自测）。生产需接入真实短信服务。
# SMS_PROVIDER=console
# SMS_CODE_TTL_SECONDS=300

# 管理员手机号（英文逗号分隔）。注册时命中该列表的手机号会获得 admin 角色，
# 可访问 /api/v1/admin/* 看板。
# ADMIN_PHONES=13800138000

# ---------------------------------------------------------------------------
# 可选：Docker 部署
# ---------------------------------------------------------------------------
# docker-compose 中用于选择宿主上存放截图/解答/归档的目录（映射到容器 /data）。
# SOLVER_DATA_DIR=./solver-data
