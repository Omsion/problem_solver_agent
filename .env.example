# 环境变量样例 —— 复制为 .env 后填入真实值
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# 注意：.env 已被 .gitignore 忽略，不要把它提交到仓库。

# ---------------------------------------------------------------------------
# 必填：API 密钥
# ---------------------------------------------------------------------------
# DeepSeek —— 求解器与辅助模型统一使用 deepseek-flash
DEEPSEEK_API_KEY=

# 智谱 —— 视觉模型（GLM-4.6V 系列，用于分类 / OCR / 视觉推理）
ZHIPU_API_KEY=

# 如果新增 provider（见 problem_solver_agent/config.py 的 SOLVER_CONFIG），
# 密钥命名规则为 {PROVIDER_NAME}_API_KEY，全部大写。

# ---------------------------------------------------------------------------
# 可选：路径（默认写在项目父目录，建议显式指定以免产物跑到别处）
# ---------------------------------------------------------------------------
# 工作根目录。其下会创建 Screenshots/、processed/、solutions/ 三个目录。
# 不设置时默认取项目目录的父目录（历史行为）。例如：
# SOLVER_ROOT_DIR=D:\Users\wzw\Pictures

# ---------------------------------------------------------------------------
# 可选：Agent 行为
# ---------------------------------------------------------------------------
# 关闭自动截图导入（默认 true）
# AUTO_IMPORT_ENABLED=true

# 连续截图的分组超时（秒），超过该时间没有新截图就视为一组完成
# GROUP_TIMEOUT=8

# 每个任务最多同时处理几个（自动导入与手动上传共享）
# MAX_CONCURRENT_TASKS=2

# 编程题求解风格：OPTIMAL（最优解）或 EXPLORATORY（讲解式）
# SOLVER_STYLE=OPTIMAL

# 求解调用的输出上限（token）。注意：思考模式下思考过程与正文**共享**这份配额，
# 被思考过程吃满时正文会是空的（此时会自动关闭思考模式重试一次）。默认 16000。
# SOLVER_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# 可选：图片预处理（决定发给视觉模型的请求体积，直接影响出答案速度）
# ---------------------------------------------------------------------------
# 发送前把图片最长边缩放到该值。调大更清晰但更慢，调小更快但小字可能糊。
# IMAGE_MAX_EDGE=1600
# JPEG 质量
# IMAGE_JPEG_QUALITY=80
# 是否启用图片磁盘缓存
# IMAGE_CACHE_ENABLED=true
# 图片缓存总上限（MB）
# IMAGE_CACHE_MAX_MB=512

# 是否把"题型分类"和"逐页转录"合并成一次视觉调用（失败会自动回退）
# USE_COMBINED_VISION_CALL=true

# 多图合并文本短于该长度时跳过"润色"调用
# MERGE_SKIP_THRESHOLD=1200

# ---------------------------------------------------------------------------
# 可选：清理与保留
# ---------------------------------------------------------------------------
# 最多保留多少个任务（超出后连同上传原图一起清理）
# TASK_RETENTION_COUNT=100
# 任务最长保留天数，0 表示不按时间清理
# TASK_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# 可选：网络与超时
# ---------------------------------------------------------------------------
# 单次 API 调用超时（秒），在 config.py 中也可调整
# VISION_TIMEOUT=120

# 服务端口（容器部署时由 compose 固定为 8000）
# PORT=8000

# ---------------------------------------------------------------------------
# 访问控制与计费（多人使用时才需要）
# ---------------------------------------------------------------------------
# 默认 false = 单用户本地模式：不需要登录，任何能访问该端口的人都能提交任务
# 并消耗你的 API 额度。多人共用或对外暴露时请设为 true。
# AUTH_ENABLED=false

# JWT 签名密钥。AUTH_ENABLED=true 时**必须**显式设置，否则每次重启都会
# 生成临时密钥，导致已登录用户全部掉线。生成方法（任选）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=

# 登录令牌有效期（分钟），默认 24 小时
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 新用户注册赠送额度（元）。这是**估算**额度，用于限制滥用而非精确账单。
# DEFAULT_USER_BUDGET=10.0

# 提交一次任务所需的最低剩余额度（元）。低于该值直接拒绝，
# 避免"余额不足却已经跑完一次付费调用"。
# MIN_TASK_BUDGET=0.05

# 短信验证码：console 表示不真正发短信，而是把验证码回显在 /api/v1/auth/send-code
# 的响应里（仅用于本地开发与自测）。生产需接入真实短信服务。
# SMS_PROVIDER=console
# SMS_CODE_TTL_SECONDS=300

# 管理员手机号（英文逗号分隔）。注册时命中该列表的手机号会获得 admin 角色，
# 可访问 /api/v1/admin/* 看板。
# ADMIN_PHONES=13800138000

# ---------------------------------------------------------------------------
# 可选：Docker 部署
# ---------------------------------------------------------------------------
# docker-compose 中用于选择宿主上存放截图/解答/归档的目录（映射到容器 /data）。
# SOLVER_DATA_DIR=./solver-data
