# ==============================================================================
# 自动化多图解题Agent — Git 忽略配置
# ==============================================================================

# --- 凭证 ---
.env

# --- 项目运行时目录 ---
/Screenshots/
/processed/
/solutions/
*.lock
.deps_ok

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/

# --- 虚拟环境 ---
venv/
.venv/
env/
ENV/

# --- IDE / 编辑器 ---
.idea/
.vscode/
.claude/
.omo/
*.swp
*~
*.sublime-project
*.sublime-workspace

# --- 测试 & 覆盖率 ---
.pytest_cache/
.coverage
htmlcov/
pytest-out.txt
eslint-out.txt

# --- 日志 ---
*.log

# --- OS 杂项 ---
.DS_Store
Thumbs.db
Desktop.ini

# Windows 设备名 (NUL, CON 等)
nul
CON
PRN
AUX
NUL
COM[0-9]
LPT[0-9]
/webapp/solutions/*
!/webapp/solutions/.gitkeep
/webapp/data/*
!/webapp/data/.gitkeep
/webapp/uploads/*
!/webapp/uploads/.gitkeep
# 图片预处理缓存（可安全删除，会自动重建）
/webapp/cache/
# 任务取消后保留的部分解答
/webapp/solutions/*.partial.md
